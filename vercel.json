{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?furniture8home\\.com" }],
      "destination": "https://admin.furniture8home.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!admin/|images/).*)",
      "has": [{ "type": "host", "value": "admin.furniture8home.com" }],
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.furniture8home.com" }],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://*.workers.dev https://*.furniture8home.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
