# PIN for the admin dashboard — required in production, 6–8 digits (dev falls back to 8888)
ADMIN_PIN=
# Port for the admin dashboard + API
PORT=4000
# Interface to listen on. Defaults to 127.0.0.1 in dev and 0.0.0.0 in production
HOST=
# Set to the number of reverse proxies in front of the server (usually 1 on Render/Railway/Nginx)
# so rate limits see real client IPs. Leave empty when clients connect directly.
TRUST_PROXY=
# Where the storefront is hosted — used for image previews and "view on store" links
VITE_STOREFRONT_URL=http://localhost:5173
# Allowed origin for storefront API calls (e.g. https://furniture8home.com); defaults to any
STOREFRONT_ORIGIN=*
# Razorpay API keys (Dashboard → Account & Settings → API Keys). Leave empty to hide online payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret for https://<backend>/api/razorpay/webhook (events: order.paid, payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
